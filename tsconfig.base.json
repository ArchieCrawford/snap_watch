{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@snapsearch/core": ["packages/core/src"],
      "@snapsearch/db": ["packages/db/src"],
      "@snapsearch/ui": ["packages/ui/src"]
    }
  }
}
